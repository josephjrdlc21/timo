# Hoist shared dev/build tooling so it resolves from any workspace package.
shamefully-hoist=false
# Keep a strict node_modules but allow common build/test tools to be hoisted.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*vitest*
public-hoist-pattern[]=*@testing-library*
public-hoist-pattern[]=*typescript*
# Fail install if the lockfile is out of date in CI.
# strict-peer-dependencies=false keeps peer mismatches as warnings, not errors.
strict-peer-dependencies=false
auto-install-peers=true
