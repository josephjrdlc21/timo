NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Auth. Both secrets are required and must be at least 32 characters — there is
# no default, so the server refuses to boot without them. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Access and refresh tokens are signed with different keys on purpose, so a
# leaked access-token key cannot be used to mint sessions.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Token lifetimes, in seconds. 900 = 15 minutes, 604800 = 7 days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

REFRESH_COOKIE_NAME="timo_refresh_token"

# Comma-separated allowlist of browser origins permitted to send credentials.
# The two Vite dev servers: client-spa and iam-admin.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Seed user created by `pnpm prisma:seed` (there is no self-service registration).
SEED_ADMIN_EMAIL="admin@timo.local"
SEED_ADMIN_NAME="TIMO Admin"
SEED_ADMIN_PASSWORD="change-this-locally"
