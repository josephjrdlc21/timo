NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
JWT_SECRET="replace-this-later"

# Seed user created by `pnpm prisma:seed` (there is no self-service registration).
SEED_ADMIN_EMAIL="admin@timo.local"
SEED_ADMIN_NAME="TIMO Admin"
SEED_ADMIN_PASSWORD="change-this-locally"
